# Copy this file to .env.local and fill in the values.
# .env.local is NEVER committed (it is in .gitignore).

# Supabase (Project Settings → API Keys). Both are public by design;
# Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets: NEVER add the NEXT_PUBLIC_ prefix to these.
# In Vercel, add them as type "Secret".

# Supabase secret key (Project Settings → API Keys → Secret keys, starts with
# sb_secret_). Used only on the server to write the shared price cache.
SUPABASE_SECRET_KEY=

# Finnhub (finnhub.io → free account → API key): US stock and ETF prices.
FINNHUB_API_KEY=

# Tiingo (tiingo.com → free account → Account → API → Token): daily stock and
# ETF closes for the performance chart. Free plan: personal use only, 50
# requests per hour. Without it the chart has no stock history.
TIINGO_API_KEY=

# CoinGecko Demo key (coingecko.com/en/api → free Demo plan): crypto fallback.
# Optional: without it CoinGecko's public limits apply.
COINGECKO_API_KEY=

# Claude API (AI import, milestone M7)
ANTHROPIC_API_KEY=
